# Copy to .env and fill in. Works with any OpenAI-compatible endpoint.
# Free by default: get a key at https://console.groq.com/keys

# Groq (free tier) -- the default.
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# --- Other free / generous alternatives (set OPENAI_BASE_URL + OPENAI_MODEL) ---
# OpenRouter (has free models, e.g. meta-llama/llama-3.3-70b-instruct:free):
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Google Gemini (OpenAI-compatible):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.0-flash

# --- OpenAI (not free) ---
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini
# Some OpenAI reasoning models (e.g. gpt-6-luna) reject tool calls unless you set:
#   OPENAI_REASONING_EFFORT=none
